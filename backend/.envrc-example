# Inherit root level envrc (Nix Flake)
source_up

# Force uv to use the Nix-provided Python interpreter rather than downloading its own
export UV_PYTHON_PREFERENCE=system

# Auto-create the virtual environment if it is missing
if [ ! -d ".venv" ]; then
    uv venv
fi

# Activate the virtual environment
source .venv/bin/activate

# Application Configuration
export DATABASE_URL="sqlite+aiosqlite:///local_dev.db"
